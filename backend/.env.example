# Port for Express server
PORT=3000

# Google Sheets Configuration
# Existing NFL Workbook ID
GOOGLE_SHEET_ID=1lutN5LmC1Hi6vtuwpkis4n-dYGElZ3Qtqn-Hk52Y2L0

# Google Service Account Credentials (JSON string or path to service-account.json)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# JWT Secret for factory token authentication
JWT_SECRET=nfl_factory_super_secure_jwt_secret_key_change_in_production

# Factory timezone
TIMEZONE=Asia/Dhaka

# Integration mode: "demo" or "live"
APP_MODE=demo
